      <dt>Emploi 2028</dt><dd>{{ R1.r.emploi[2028] | num(0) }} 000</dd>
      <dt>Dette 2031</dt><dd>{{ R1.r.dette[2031] | num(0) }} % du PIB</dd>
    </dl>
  </section>
  <section>
    <h3>Le moins de récession : {{ R2.familles | length }} familles</h3>
    <ol class="petit">{% for f in R2.familles %}<li><a href="/familles/{{ f.code | lower }}/">{{ f.code }}</a> · {{ f.label }} — {{ f.net | meur }}</li>{% endfor %}</ol>
    <dl class="dl-grille petit">
      <dt>Solde 2028</dt><dd>{{ R2.r.solde[2028] | num(1) }} % du PIB</dd>
